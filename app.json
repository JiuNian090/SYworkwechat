{
  "darkmode": true,
  "themeLocation": "theme.json",
  "lazyCodeLoading": "requiredComponents",
  "pages": [
    "pages/schedule/schedule",
    "pages/plan/plan",
    "pages/statistics/statistics",
    "pages/profile/profile",
    "pages/user-manage/index"
  ],
  "subpackages": [
    {
      "root": "subpkg-common",
      "name": "common",
      "pages": [
        "pages/docs/docs",
        "pages/agreement/agreement"
      ]
    }
  ],
  "preloadRule": {
    "pages/profile/profile": {
      "network": "all",
      "packages": ["common"]
    },
    "pages/statistics/statistics": {
      "network": "all",
      "packages": ["common"]
    }
  },
  "window": {
    "backgroundTextStyle": "@bgTxtStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTitleText": "SYwork",
    "navigationBarTextStyle": "@navTxtStyle"
  },
  "tabBar": {
    "color": "@tabFontColor",
    "selectedColor": "@tabSelectedColor",
    "borderStyle": "@tabBorderStyle",
    "backgroundColor": "@tabBgColor",
    "position": "bottom",
    "list": [
      {
        "pagePath": "pages/plan/plan",
        "text": "计划",
        "iconPath": "images/list-add.png",
        "selectedIconPath": "images/list-add1.png"
      },
      {
        "pagePath": "pages/schedule/schedule",
        "text": "排班",
        "iconPath": "images/schedule.png",
        "selectedIconPath": "images/schedule1.png"
      },
      {
        "pagePath": "pages/statistics/statistics",
        "text": "统计",
        "iconPath": "images/status.png",
        "selectedIconPath": "images/status1.png"
      },
      {
        "pagePath": "pages/profile/profile",
        "text": "我的",
        "iconPath": "images/me.png",
        "selectedIconPath": "images/me1.png"
      }
    ]
  }
}
