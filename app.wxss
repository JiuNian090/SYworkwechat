/* app.wxss - 全局 CSS 变量（暗色模式统一来源） */

page {
  /* 主色调 */
  --primary-color: #34d399;
  --primary-light: #6ee7b7;
  --primary-dark: #10b981;

  /* 背景 */
  --bg-color: #f5f5f5;
  --card-bg: #ffffff;

  /* 文字 */
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-tertiary: #999999;

  /* 边框与阴影 */
  --border-color: #e5e5e5;
  --shadow-color: rgba(0, 0, 0, 0.08);
  --shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  --shadow-hover: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);

  /* 功能色 */
  --success-color: #34d399;
  --warning-color: #fbbf24;
  --error-color: #f87171;
  --danger-color: #f87171;
  --info-color: #60a5fa;

  /* 班次类型色 */
  --day-shift-color: #fbbf24;
  --night-shift-color: #6366f1;
  --off-day-color: #999999;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;

  /* 标签系统色值（统计页专用） */
  --tag-radius: 10rpx;
  --tag-font: 22rpx;
  --tag-padding-x: 16rpx;
  --tag-padding-y: 5rpx;
  --tag-date-bg: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  --tag-date-text: #2e7d32;
  --tag-date-weekday: #66bb6a;
  --tag-shift-bg: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
  --tag-shift-text: #1565c0;
  --tag-hours-bg: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  --tag-hours-text: #e65100;

  /* 页面头渐变 */
  --header-gradient: linear-gradient(135deg, #34d399 0%, #10b981 100%);
  --header-gradient-dark: linear-gradient(135deg, #2d7a5a 0%, #1a5a3a 100%);

  /* docs 页面专用 */
  --title-color: #1a1a1a;
  --text-color: #4a4a4a;
  --tip-bg: rgba(24, 119, 242, 0.08);
  --tip-border: rgba(24, 119, 242, 0.15);
  --tip-text: #1877f2;
  --info-bg: rgba(52, 211, 153, 0.1);
  --info-border: rgba(52, 211, 153, 0.2);
  --info-text: #10b981;
  --warning-bg: rgba(245, 158, 11, 0.08);
  --warning-border: rgba(245, 158, 11, 0.15);
  --warning-text: #d97706;
  --danger-bg: rgba(239, 68, 68, 0.08);
  --danger-border: rgba(239, 68, 68, 0.15);
  --danger-text: #dc2626;
  --code-bg: rgba(0, 0, 0, 0.05);
  --code-text: #374151;
}

@media (prefers-color-scheme: dark) {
  page {
    --bg-color: #1a1a1a;
    --card-bg: #262626;
    --text-primary: #e5e5e5;
    --text-secondary: #a3a3a3;
    --text-tertiary: #737373;
    --border-color: #333333;
    --shadow-color: rgba(0, 0, 0, 0.4);
    --shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
    --shadow-hover: 0 4rpx 20rpx rgba(0, 0, 0, 0.4);
    --primary-color: #3a9a7a;
    --primary-light: #4a9a7a;
    --primary-dark: #1a5a3a;
    --success-color: #3a9a7a;
    --warning-color: #c89838;
    --error-color: #b06060;
    --danger-color: #b06060;
    --info-color: #5588b0;
    --day-shift-color: #c89838;
    --night-shift-color: #5a5aaa;
    --off-day-color: #6a6a6a;
    --tag-date-bg: linear-gradient(135deg, #1a3a1a 0%, #1a4a1a 100%);
    --tag-date-text: #66bb6a;
    --tag-date-weekday: #4a9a5a;
    --tag-shift-bg: linear-gradient(135deg, #1a2a3a 0%, #1a3a4a 100%);
    --tag-shift-text: #5a9ac0;
    --tag-hours-bg: linear-gradient(135deg, #2a2a1a 0%, #3a2a1a 100%);
    --tag-hours-text: #d08030;

    --header-gradient: linear-gradient(135deg, #2d7a5a 0%, #1a5a3a 100%);
    --header-gradient-dark: linear-gradient(135deg, #2d7a5a 0%, #1a5a3a 100%);

    --title-color: #e5e5e5;
    --text-color: #a3a3a3;
    --tip-bg: rgba(24, 119, 242, 0.15);
    --tip-border: rgba(24, 119, 242, 0.25);
    --tip-text: #3b82f6;
    --info-bg: rgba(52, 211, 153, 0.15);
    --info-border: rgba(52, 211, 153, 0.25);
    --info-text: #34d399;
    --warning-bg: rgba(245, 158, 11, 0.15);
    --warning-border: rgba(245, 158, 11, 0.25);
    --warning-text: #fbbf24;
    --danger-bg: rgba(239, 68, 68, 0.15);
    --danger-border: rgba(239, 68, 68, 0.25);
    --danger-text: #f87171;
    --code-bg: rgba(255, 255, 255, 0.1);
    --code-text: #e5e7eb;
  }
}

/*
 * ── 编码规范：新写 UI 时颜色引用规则 ──
 * 页面/容器背景    → var(--bg-color)
 * 卡片/块背景      → var(--card-bg)
 * 主文字           → var(--text-primary)
 * 次要文字         → var(--text-secondary)
 * 弱化文字         → var(--text-tertiary)
 * 边框/分割线      → var(--border-color)
 * 阴影             → var(--shadow-color) / var(--shadow)
 * 主色背景/按钮    → var(--primary-color)
 * 页面头渐变       → var(--header-gradient)
 * 成功色           → var(--success-color)
 * 警告色           → var(--warning-color)
 * 错误色           → var(--error-color)
 * 输入框背景       → var(--bg-color) 或 var(--card-bg)
 * 弹窗蒙层         → rgba(0, 0, 0, 0.5)
 * 组件隔离         → styleIsolation: "apply-shared"
 *
 * 不要用：color: #333 / background: #fff / border: 1rpx solid #eee
 * 不要在每个页面重写 @media (prefers-color-scheme: dark)
 * 新增页面只需引用 var(--xxx)，暗色自动生效
 */