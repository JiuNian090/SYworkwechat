page {
  background-color: #f5f5f5;
}

.container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.content {
  max-width: 720rpx;
  margin: 0 auto;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1f2937;
  text-align: center;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

.update-date {
  display: block;
  font-size: 32rpx;
  color: #9ca3af;
  text-align: right;
  margin-top: 48rpx;
}

.section {
  margin-bottom: 36rpx;
  text-align: left;
}

.section-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
  line-height: 1.6;
  text-align: left;
}

.text {
  display: block;
  font-size: 36rpx;
  color: #4b5563;
  line-height: 2;
  margin-bottom: 32rpx;
  text-align: left;
}

@media (prefers-color-scheme: dark) {
  page {
    background-color: #1a1a1a;
  }

  .title {
    color: #e5e5e5;
  }

  .update-date {
    color: #737373;
  }

  .section-title {
    color: #e5e5e5;
  }

  .text {
    color: #a3a3a3;
  }
}
