page {
  background-color: var(--bg-color);
}

.container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.content {
  max-width: 720rpx;
  margin: 0 auto;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

.update-date {
  display: block;
  font-size: 32rpx;
  color: var(--text-tertiary);
  text-align: right;
  margin-top: 48rpx;
}

.section {
  margin-bottom: 36rpx;
  text-align: left;
}

.section-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  line-height: 1.6;
  text-align: left;
}

.text {
  display: block;
  font-size: 36rpx;
  color: var(--text-secondary);
  line-height: 2;
  margin-bottom: 32rpx;
  text-align: left;
}